# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/inspir_connect?schema=public"

# --- Redis (rate limiting, session blacklist) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="replace-with-64-byte-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-64-byte-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# --- App ---
NODE_ENV="development"
PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:19006,exp://192.168.0.0:19000"

# --- Platform Owner bootstrap (used only by seed script, one-time) ---
OWNER_BOOTSTRAP_EMAIL="you@example.com"
OWNER_BOOTSTRAP_PASSWORD="set-a-strong-temporary-password-then-change-it"

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX="10"
